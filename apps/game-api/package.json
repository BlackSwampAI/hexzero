{
  "name": "@hexzero/game-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hexzero/agent-runtime": "workspace:*",
    "@hexzero/experiment-archive": "workspace:*",
    "@hexzero/shared": "workspace:*",
    "@hexzero/world-engine": "workspace:*",
    "@hono/node-server": "2.1.0",
    "h3-js": "4.5.0",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
